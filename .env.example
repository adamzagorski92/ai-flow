# OpenCode provider switch
OPENCODE_PROVIDER=opencode

# OpenCode Zen preset used when OPENCODE_PROVIDER=opencode
OPENCODE_ZEN_MODEL_ID=kimi-k2.6
OPENCODE_ZEN_SMALL_MODEL_ID=gpt-5.4-nano

# OpenRouter preset used when OPENCODE_PROVIDER=openrouter
OPENROUTER_MODEL_ID=moonshotai/kimi-k2
OPENROUTER_SMALL_MODEL_ID=openai/gpt-4.1-mini

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://github.com/adamzagorski92/ai-flow
OPENROUTER_APP_NAME=ai-flow-workbench

# Application code tracked in Git under ./apps/
# All apps in ./apps/ (Turborepo-style: ./apps/web, ./apps/api, etc.)

# Git identity inside the container
GIT_AUTHOR_NAME="Twoje Imie"
GIT_AUTHOR_EMAIL=twoj-email@example.com
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# Optional GitHub CLI token. Leave empty if you prefer `gh auth login` inside the container.
GH_TOKEN=

# Host OS for voice input.
# Use `auto` for uname-based detection in voice.sh.
HOST_OS=auto

# Linux/X11 auto voice daemon.
# Set COMPOSE_PROFILES=voice-linux on Linux to start it automatically with `docker compose up -d`.
COMPOSE_PROFILES=
VOICE_LANGUAGE=pl
VOICE_HOTKEY_KEYCODE=64
VOICE_INSERT_MODE=xdotool
VOICE_TYPE_DELAY_MS=1
VOICE_PRESS_ENTER_AFTER_TYPE=0
VOICE_PULSE_INPUT=default

# Whisper.cpp model downloaded on first container start.
WHISPER_MODEL=medium
WHISPER_MODEL_URL=

# Linux and WSL users can set their real UID/GID to avoid permission issues on bind mounts.
LOCAL_UID=1000
LOCAL_GID=1000

# Optional image override knobs. Pin these to reproducible versions rather than @latest/master.
WORKBENCH_IMAGE=ai-flow/workbench:latest
WORKBENCH_CONTAINER_NAME=ai-flow-workbench
OPENCODE_NPM_SPEC=opencode-ai@1.15.13
BEADS_NPM_SPEC=@beads/bd@1.0.4
WHISPER_CPP_REF=v1.8.5
